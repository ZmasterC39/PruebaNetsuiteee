/**
 * @NApiVersion 2.x
 * @NScriptType Portlet
 */
define(['N/url'], function(url) {
    function render(params) {
        var suiteletUrl = url.resolveScript({
            scriptId: '5495', // Cambia por el ID de tu Suitelet
            deploymentId: '1' // Cambia por el ID del despliegue
        });

        // Agrega el contenido al portlet
        params.portlet.title = 'Mi Suitelet Personalizado CUMPLIMIENTO'; // Título del portlet
        params.portlet.html = '<iframe src="' + suiteletUrl + '" width="100%" height="400px" frameborder="0"></iframe>';
    }

    return {
        render: render
    };
});
